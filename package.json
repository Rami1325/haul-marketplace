{
  "name": "haul",
  "version": "0.1.0",
  "private": true,
  "description": "A truck and a pair of hands, on demand — at a price that doesn't move.",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:generate": "pnpm --filter @haul/db generate",
    "db:migrate": "pnpm --filter @haul/db migrate",
    "db:seed": "pnpm --filter @haul/db seed",
    "db:studio": "pnpm --filter @haul/db studio"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
