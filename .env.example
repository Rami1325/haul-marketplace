# ---------------------------------------------------------------------------
# HAUL — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Market -----------------------------------------------------------------
# Everything money/locale-shaped is driven from here, so expansion is config.
HAUL_DEFAULT_CITY=tel-aviv
HAUL_DEFAULT_LOCALE=he
HAUL_CURRENCY=ILS

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgresql://haul:haul_dev@localhost:5432/haul
REDIS_URL=redis://localhost:6379

# --- Dispatch service -------------------------------------------------------
DISPATCH_PORT=4000
DISPATCH_WS_URL=ws://localhost:4000
# Shared secret between API and dispatch. Generate: openssl rand -hex 32
DISPATCH_INTERNAL_SECRET=

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISPATCH_WS_URL=ws://localhost:4000

# --- Auth -------------------------------------------------------------------
# Generate: openssl rand -hex 32
AUTH_SECRET=

# --- Payments ---------------------------------------------------------------
# Acquiring only — customer money in. Driver money out is a separate rail with
# its own settings below, because no Israeli PSP offers marketplace payouts.
#
# fake | payplus | hyp. There is no Stripe option and there will not be one:
# locked decision 10 ruled it out because it cannot pay Israeli drivers, and
# leaving the name here as a default would keep pointing new work at an
# architecture this project has already rejected.
#
# `fake` is a complete in-memory PSP (@haul/payments) — tokenise, J5 authorize,
# partial capture, void, refund, idempotency. The whole booking flow runs on it
# with no merchant account, which is what keeps a fresh checkout usable.
PAYMENT_PROVIDER=fake

# PayPlus. Adapter is a skeleton pending a sandbox terminal — see TRACKING.md
# open questions 3a-3c, all of which change the code and not just these values.
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_TERMINAL_UID=
PAYPLUS_CASHIER_UID=
PAYPLUS_BASE_URL=
PAYPLUS_WEBHOOK_SECRET=

# HYP has no adapter yet and therefore no credentials listed. Guessing at its
# variable names here would put keys in this file that nothing reads and that
# nobody can check against a terminal.

# --- Payout -----------------------------------------------------------------
# manual_export writes a CSV for the bank portal. Masav needs a record layout
# that comes from the bank, so it is not inventable ahead of an account.
PAYOUT_PROVIDER=manual_export

# --- Maps & routing ---------------------------------------------------------
# fake | google. Distance must be routed, never straight-line (decision 9).
# `fake` serves a seeded Tel Aviv dataset so the flow develops with no Google
# account; @haul/geo refuses to default to it in production, because a forgotten
# variable there would quote real customers off invented streets.
GEO_PROVIDER=fake

# Server-side only, and deliberately so. There is no NEXT_PUBLIC_ twin: a Places
# key inlined into the browser bundle is a key anyone can lift out of a page and
# bill to us, and Google's referrer restrictions are a request header, not
# authentication. Autocomplete and routing go through a server route handler,
# which is also where the caching that keeps that bill small has to live.
GOOGLE_MAPS_API_KEY=

# --- Comms ------------------------------------------------------------------
# Number masking so neither side keeps the other's phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PROXY_SERVICE_SID=

# --- Storage ----------------------------------------------------------------
# Proof-of-condition photos and driver documents.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=haul-proof
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
